API=https://pwc-pay-api.chiachair.com/v1
MCH_NO=your-merchant-no
APP_ID=your-app-id
PRIVATE_KEY=./keys/private.pem
# PRIVATE_KEY_PASSPHRASE=
PLATFORM_PUBLIC_KEY=./keys/platform_public_key.pem

# Used by src/create-payout.ts. Every run sends a REAL payout: replace every placeholder first.
# Use a new PAYOUT_MCH_ORDER_NO per payout and keep it unchanged when retrying that payout.
PAYOUT_MCH_ORDER_NO=
PAYOUT_FIAT_AMOUNT=100.00
PAYOUT_FIAT_CURRENCY=PHP
PAYOUT_QR_CONTENT="0002010102116010Laoag City5802PH5204601653036085914CARLO BRYAN B.27610012com.p2pqrpay0414208607488593630111CIPHPHMMXXX02089996440363047FED"
PAYOUT_USER_EMAIL=saguipiljude@gmail.com
PAYOUT_NOTIFY_URL=https://webhook.site/e578a31c-3f2b-405f-aaf7-5f50cd1a126b
PAYOUT_EXT_PARAM=anything

# Used by src/query-payout.ts when PAYOUT_MCH_ORDER_NO is empty
PAYOUT_ORDER_ID=

# Used by src/notify-server.ts
NOTIFY_PORT=3000
